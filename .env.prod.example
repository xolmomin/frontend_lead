# /var/www/lead/frontend/.env uchun template (VPSda)
# Faqat compose interpolation uchun o'qiladi — konteynerga env sifatida berilmaydi.

# Har deployda CI shu qatorni commit sha'ga almashtiradi. Rollback = shu bitta qatorni tahrirlash.
IMAGE=ghcr.io/xolmomin/frontend_lead:latest

# NEXT_PUBLIC_API_URL bu yerda EMAS. Next uni buildda bundle ichiga inline qiladi
# (src/lib/api.ts), runtime env ishlamaydi. U GitHub repo variable sifatida beriladi va
# Dockerfile'ga build-arg bo'lib tushadi. O'zgartirsangiz image qayta build bo'lishi shart.
