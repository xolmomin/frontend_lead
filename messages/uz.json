    "faq": {
      "eyebrow": "Savol-javob",
      "title": "Ko'p so'raladigan savollar",
      "subtitle": "Javob topolmadingizmi? Telegramda yozing — tez orada javob beramiz.",
      "q1": {
        "q": "Yuboraman qanday ishlaydi?",
        "a": "Facebook reklama akkauntingizni OAuth orqali ulaysiz, Yuboraman Lead Ads formalaringizga webhook o'rnatadi. Mijoz formani to'ldirishi bilan lid bizga keladi va soniyalar ichida siz tanlagan CRM yoki Telegramga yuboriladi."
      },
      "q2": {
        "q": "Xizmat qancha turadi?",
        "a": "Boshlang'ich tarif bepul — oyiga 1 000 lidgacha. Pullik tariflar oyiga 49 000 so'mdan boshlanadi. Yillik to'lovda 2 oy bepul."
      },
      "q3": {
        "q": "Lid yo'qolib qolsa nima bo'ladi?",
        "a": "Hech narsa yo'qolmaydi. Yetkazishda xato bo'lsa, tizim avtomatik qayta urinadi. Integratsiya pauzada bo'lsa, lidlar navbatda saqlanadi va keyin yuboriladi. Har bir urinish jurnalda ko'rinadi."
      },
      "q4": {
        "q": "Qaysi CRM tizimlari qo'llab-quvvatlanadi?",
        "a": "Bitrix24, amoCRM (Kommo), Google Sheets va Telegram bot — tayyor holda. Universal webhook orqali esa istalgan boshqa tizimga ulash mumkin."
      },
      "q5": {
        "q": "Nechta Facebook akkaunt ulash mumkin?",
        "a": "Barcha tariflarda 100 tagacha Facebook akkaunt ulash mumkin — agentliklar uchun ham qulay."
      },
      "q6": {
        "q": "To'lovni qanday amalga oshiraman?",
        "a": "To'lov so'mda: bank kartasidan o'tkazma (chekni yuklaysiz, tez tasdiqlanadi) yoki onlayn to'lov orqali. Balansingizdan tarif avtomatik yechiladi."
      },
      "q7": {
        "q": "Bepul tarifda qanday cheklovlar bor?",
        "a": "Boshlang'ich tarif oyiga 1 000 lidgacha bepul ishlaydi va muddati cheklanmagan. Asosiy integratsiyalar va analitika ochiq."
      },
      "q8": {
        "q": "Texnik yordam qanday ishlaydi?",
        "a": "Qo'llab-quvvatlash 24/7 Telegram orqali ishlaydi. Ilk sozlashda mutaxassisimiz bepul yordam beradi."
      },
      "q9": {
        "q": "Ma'lumotlarim xavfsizmi?",
        "a": "Ha. Barcha trafik SSL orqali shifrlanadi, serverlar DDoS himoyasi ostida. Facebook tokenlari shifrlangan holda saqlanadi va uchinchi shaxslarga berilmaydi."
      }
    },
